# Frontend configuration. Copy to `.env` and adjust.
# Every variable must start with VITE_ to reach the browser.

# --- API base -------------------------------------------------------------
# Leave blank (or omit) to use "/api", which vite.config.js proxies to
# http://localhost:4000 in dev, and which a reverse proxy should serve in
# production from the same origin as the site.
#
# Set to an absolute URL to point the app at a remote backend. Note it must
# include the /api path segment:
#   VITE_API_BASE=https://your-api-host.example.com/api
VITE_API_BASE=

# --- Uploaded media -------------------------------------------------------
# Product and banner images come back from the API as paths relative to it
# ("/uploads/products/x.jpg") and are resolved against VITE_API_BASE, so they
# ride the same /api prefix a reverse proxy already forwards. Nothing to set
# here unless media is served from somewhere else again (a CDN or S3 bucket),
# which then serves those paths from its own root:
#   VITE_MEDIA_BASE=https://cdn.example.com
VITE_MEDIA_BASE=
